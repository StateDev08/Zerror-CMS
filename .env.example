# Bei Namen mit Leerzeichen unbedingt in Anführungszeichen setzen (z. B. "Pax Dei - Mein Clan")
APP_NAME=ZerroCMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id
# Argon2id-Parameter (OWASP-nah): Memory in KiB, Time-Cost, Threads
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1
# false lassen, solange noch bcrypt-Hashes in der DB sind (Migration beim Login)
HASH_VERIFY=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zerrocms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Nach erfolgreicher Installation setzt der Installer database + encrypt
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Für Public: SMTP statt log
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

CLAN_NAME="${APP_NAME}"
CLAN_THEME=pax-dei
CLAN_LOGO=
CLAN_BANNER=
APPLICATION_NOTIFY_EMAIL=
DISCORD_WEBHOOK_URL=
DISCORD_INVITE_URL=
DONATION_URL=

DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_BOT_API_KEY=
DISCORD_SHOP_WEBHOOK_URL=
DISCORD_EVENTS_WEBHOOK_URL=
